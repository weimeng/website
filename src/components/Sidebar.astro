---
import { navData } from "../lib/navigation";
import NavigationList from "./NavigationList.astro";
---

<aside
	class="fixed w-full sm:static sm:table-cell sm:w-72 bg-black text-gray-500 p-3 sm:p-"
	id="site-sidebar"
>
	<div class="flex">
		<h2 class="text-xl uppercase font-bold sm:mb-2 flex-auto">
			Wei Meng's Website
		</h2>
		<button
			type="button"
			class="flex-shrink uppercase sm:hidden btn p-0 px-1"
			id="sidebar-menu-toggle"
			aria-expanded="false"
			aria-controls="sidebar-nav"
		>
			Menu
		</button>
	</div>
	<div class="hidden sm:block" id="sidebar-nav">
		<NavigationList navItems={navData.navigation} />
	</div>
</aside>

<script>
	const toggle = document.getElementById("sidebar-menu-toggle");
	const nav = document.getElementById("sidebar-nav");
	if (toggle && nav) {
		toggle.addEventListener("click", () => {
			const expanded = toggle.getAttribute("aria-expanded") === "true";
			toggle.setAttribute("aria-expanded", String(!expanded));
			nav.classList.toggle("hidden", expanded);
		});
	}
</script>
