---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const siteTitle = "Wei Meng's website";
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-PGVTC7T");
		</script>
	</head>
	<body class="bg-gray-900">
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-PGVTC7T"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>
		<div class="sm:table sm:h-screen sm:w-full">
			<div class="sm:table-row">
				<slot name="sidebar" />
				<div class="sm:table-cell bg-gray-900 text-gray-200 pt-20 p-6 sm:pt-6">
					<slot />
				</div>
			</div>
		</div>
	</body>
</html>
