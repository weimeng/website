{"componentChunkName":"component---src-pages-asciidoc-fields-path-tsx","path":"/stacks/windows-dev","result":{"data":{"asciidoc":{"html":"<div class=\"sect1\">\n<h2 id=\"_setup\">Setup</h2>\n<div class=\"sectionbody\">\n<div class=\"paragraph\">\n<p>Enable Developer Mode:</p>\n</div>\n<div class=\"olist arabic\">\n<ol class=\"arabic\">\n<li>\n<p>Search for <code>developer</code> and click on \"Developer settings\"</p>\n</li>\n<li>\n<p>Enable the \"Developer Mode\" toggle</p>\n</li>\n</ol>\n</div>\n<div class=\"paragraph\">\n<p>Source: <a href=\"https://learn.microsoft.com/en-us/windows/apps/get-started/enable-your-device-for-development\">Enable development mode</a>\n(required for <a href=\"#_install_node_js_with_volta\">Volta</a>)</p>\n</div>\n</div>\n</div>\n<div class=\"sect1\">\n<h2 id=\"_toolchain\">Toolchain</h2>\n<div class=\"sectionbody\">\n<div class=\"sect2\">\n<h3 id=\"_terminal\">Terminal</h3>\n<div class=\"ulist\">\n<ul>\n<li>\n<p><a href=\"https://github.com/microsoft/terminal\">Windows Terminal</a>: terminal emulator</p>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install Microsoft.WindowsTerminal</code></pre>\n</div>\n</div>\n<div class=\"ulist\">\n<ul>\n<li>\n<p><a href=\"https://github.com/g-e-o-m-e-t-r-i-c/tokyonight-windows-terminal\">Tokyo Night colour scheme</a></p>\n</li>\n</ul>\n</div>\n</li>\n<li>\n<p><a href=\"https://starship.rs/\">Starship: Cross-Shell Prompt</a></p>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install Starship.Starship</code></pre>\n</div>\n</div>\n</li>\n</ul>\n</div>\n</div>\n<div class=\"sect2\">\n<h3 id=\"_others\">Others</h3>\n<div class=\"ulist\">\n<ul>\n<li>\n<p><a href=\"https://code.visualstudio.com/\">Visual Studio Code</a>: code editor</p>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install Microsoft.VisualStudioCode</code></pre>\n</div>\n</div>\n</li>\n<li>\n<p><a href=\"https://zealdocs.org/\">Zeal</a>: offline docs browser</p>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install OlegShparber.Zeal</code></pre>\n</div>\n</div>\n</li>\n<li>\n<p><a href=\"https://github.com/oldj/SwitchHosts\">SwitchHosts</a>: hosts manager</p>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install oldj.switchhosts</code></pre>\n</div>\n</div>\n</li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n<div class=\"sect1\">\n<h2 id=\"_git\">Git</h2>\n<div class=\"sectionbody\">\n<div class=\"paragraph\">\n<p>Install <a href=\"https://git-scm.com/download/win\">Git for Windows</a>:</p>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install Git.Git</code></pre>\n</div>\n</div>\n<div class=\"paragraph\">\n<p>Generate SSH key:</p>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">ssh-keygen -t ed25519 -C \"your_email@example.com\"</code></pre>\n</div>\n</div>\n<div class=\"paragraph\">\n<p>Copy public key file contents to clipboard:</p>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">Get-Content ~/.ssh/id_ed25519.pub | Set-Clipboard</code></pre>\n</div>\n</div>\n</div>\n</div>\n<div class=\"sect1\">\n<h2 id=\"_node_js\">Node.js</h2>\n<div class=\"sectionbody\">\n<div class=\"sect2\">\n<h3 id=\"_install_node_js_with_volta\">Install Node.js with Volta</h3>\n<div class=\"paragraph\">\n<p>Install <a href=\"https://volta.sh/\">Volta</a>:</p>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">winget install Volta.Volta</code></pre>\n</div>\n</div>\n<div class=\"paragraph\">\n<p>Install latest <a href=\"https://nodejs.org/\">Node.js</a> LTS release:</p>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-powershell\" data-lang=\"powershell\">volta install node</code></pre>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"sect1\">\n<h2 id=\"_windows_subsystem_for_linux\">Windows Subsystem for Linux</h2>\n<div class=\"sectionbody\">\n<div class=\"ulist\">\n<ul>\n<li>\n<p><a href=\"https://learn.microsoft.com/en-us/windows/wsl/install#manual-installation-steps\">Windows Subsystem for Linux 2</a></p>\n</li>\n<li>\n<p><a href=\"https://www.microsoft.com/store/productId/9PKR34TNCV07\">Kali Linux</a> (WSL2)</p>\n</li>\n</ul>\n</div>\n</div>\n</div>","document":{"title":"Windows development environment","subtitle":"","main":"Windows development environment"}},"site":{"siteMetadata":{"title":"Wei Meng's website"}}},"pageContext":{"id":"a5bc6392-69fe-576d-8191-b3106a026c13","fields__path":"/stacks/windows-dev","__params":{"fields__path":"stacks"}}},"staticQueryHashes":[],"slicesMap":{}}