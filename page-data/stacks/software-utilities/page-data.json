{"componentChunkName":"component---src-pages-asciidoc-fields-path-tsx","path":"/stacks/software-utilities","result":{"data":{"asciidoc":{"html":"<div id=\"toc\" class=\"toc\">\n<div id=\"toctitle\">Table of Contents</div>\n<ul class=\"sectlevel1\">\n<li><a href=\"#_downloaders\">Downloaders</a>\n<ul class=\"sectlevel2\">\n<li><a href=\"#_gallery_dl\">gallery-dl</a></li>\n<li><a href=\"#_yt_dlp\">yt-dlp</a></li>\n</ul>\n</li>\n<li><a href=\"#_media\">Media</a>\n<ul class=\"sectlevel2\">\n<li><a href=\"#_ffmpeg\">ffmpeg</a></li>\n</ul>\n</li>\n</ul>\n</div>\n<div class=\"sect1\">\n<h2 id=\"_downloaders\">Downloaders</h2>\n<div class=\"sectionbody\">\n<div class=\"sect2\">\n<h3 id=\"_gallery_dl\">gallery-dl</h3>\n<div class=\"sect3\">\n<h4 id=\"_install\">Install</h4>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-shell\" data-lang=\"shell\">winget install mikf.gallery-dl</code></pre>\n</div>\n</div>\n</div>\n<div class=\"sect3\">\n<h4 id=\"_usage\">Usage</h4>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-shell\" data-lang=\"shell\">gallery-dl --filename \"{num:&gt;03} - {filename}.{extension}\" --cbz https://example.com/url</code></pre>\n</div>\n</div>\n</div>\n</div>\n<div class=\"sect2\">\n<h3 id=\"_yt_dlp\">yt-dlp</h3>\n<div class=\"paragraph\">\n<p><a href=\"https://github.com/yt-dlp/yt-dlp\">yt-dlp</a></p>\n</div>\n<div class=\"sect3\">\n<h4 id=\"_install_2\">Install</h4>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-shell\" data-lang=\"shell\">winget install yt-dlp.yt-dlp</code></pre>\n</div>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-shell\" data-lang=\"shell\">pip install --upgrade yt-dlp</code></pre>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"sect1\">\n<h2 id=\"_media\">Media</h2>\n<div class=\"sectionbody\">\n<div class=\"sect2\">\n<h3 id=\"_ffmpeg\">ffmpeg</h3>\n<div class=\"sect3\">\n<h4 id=\"_usage_2\">Usage</h4>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-shell\" data-lang=\"shell\">for a in ./*.flac; do\n  ffmpeg -i \"$f\" -ab 320k -map_metadata 0 -id3v2_version 3 \"${f[@]/%flac/mp3}\";\ndone</code></pre>\n</div>\n</div>\n<div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-shell\" data-lang=\"shell\">for f in ./*.m4a; do\n  ffmpeg -i \"$f\" -vsync 0 -acodec libmp3lame -ab 320k -map_metadata 0 -id3v2_version 3 \"${f%.m4a}.mp3\";\ndone</code></pre>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>","document":{"title":"Software Utilities","subtitle":"","main":"Software Utilities"}},"site":{"siteMetadata":{"title":"Wei Meng's website"}}},"pageContext":{"id":"55c66ea3-3705-5da1-8195-b8b198c6a64a","fields__path":"/stacks/software-utilities","__params":{"fields__path":"stacks"}}},"staticQueryHashes":[],"slicesMap":{}}